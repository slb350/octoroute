[Unit]
Description=Strix llama.cpp inference server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steve
Group=steve
SupplementaryGroups=render
WorkingDirectory=/home/steve/dev/llama.cpp
ExecStart=/home/steve/dev/llama.cpp/build/bin/llama-server \
    -m /home/steve/dev/llama.cpp/models/agents-a1-q8/Agents-A1-Q8_0.gguf \
    --alias strixtea \
    -c 65536 \
    -ngl 999 \
    -fa on \
    -t 32 \
    -b 2048 \
    --host 127.0.0.1 \
    --port 8080 \
    --parallel 1 \
    --metrics \
    --temp 0.85 \
    --top-p 0.95 \
    --top-k 20 \
    --presence-penalty 1.10 \
    --repeat-penalty 1.00
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
