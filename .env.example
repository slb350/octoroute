# Copy this file to `.env` before running Octoroute.
# Add only credentials referenced by the active configuration. The inbound key
# is required at startup; provider keys are resolved lazily when selected. The
# repository example also references KIMI_API_KEY, ZAI_API_KEY, and OPENAI_API_KEY.
OCTOROUTE_API_KEY=
OPENROUTER_API_KEY=
