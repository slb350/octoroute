# Copy this file to `.env` before running Octoroute.
# Add only credentials referenced by the active configuration. The v2 example
# requires the two values below; v3 provider entries may reference additional
# variables such as KIMI_API_KEY, ZAI_API_KEY, or OPENAI_API_KEY.
OCTOROUTE_API_KEY=
OPENROUTER_API_KEY=
