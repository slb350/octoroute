# Copy this file to `.env` before running Octoroute.
# Add only credentials referenced by the active configuration. The inbound key
# is required at startup; provider keys are resolved lazily when selected or
# when an operator refreshes provider readiness after its cache expires.
OCTOROUTE_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
