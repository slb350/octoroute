#!/bin/bash
#
# Pre-commit hook for Octoroute.
#
# Tracked in .githooks/ so the checks are the same for every clone. Enable with:
#   git config core.hooksPath .githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# fmt and clippy read the working tree while the commit is the index, and this is a plain Git hook, so nothing stashes unstaged work first. The two must match, with no untracked inputs. The mutation run builds a snapshot of the index, so it needs no such check.
if ! git diff --quiet -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-commit: the working tree must match the index, with no untracked inputs" >&2
    echo "            stage the intended changes or isolate the commit; no files have been altered" >&2
    exit 1
fi

echo "Running pre-commit checks..."

if ! cargo fmt --all -- --check; then
    echo "Code is not formatted. Format and stage the intended changes before committing." >&2
    exit 1
fi

if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo "Clippy reported warnings. Fix them before committing."
    exit 1
fi

# Mutation-test the staged change. A green suite proves the tests ran, not that
# they would notice if the code were wrong; a surviving mutant is a test that
# cannot distinguish correct behaviour from incorrect. Scoped to the diff, so
# the cost tracks the change rather than the tree.
if [ -x ./scripts/mutants-staged.sh ]; then
    ./scripts/mutants-staged.sh
fi

echo "Pre-commit checks passed"
exit 0
