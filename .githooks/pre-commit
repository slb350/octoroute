#!/bin/bash
#
# Pre-commit hook for Octoroute.
#
# Tracked in .githooks/ so the checks are the same for every clone. Enable with:
#   git config core.hooksPath .githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# shellcheck source=scripts/mutants-common.sh
. scripts/mutants-common.sh
require_matching_index

echo "Running pre-commit checks..."

if ! cargo fmt --all -- --check; then
    echo "Code is not formatted. Format and stage the intended changes before committing." >&2
    exit 1
fi

if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo "Clippy reported warnings. Fix them before committing."
    exit 1
fi

# Mutation-test the staged change. A green suite proves the tests ran, not that
# they would notice if the code were wrong; a surviving mutant is a test that
# cannot distinguish correct behaviour from incorrect. Scoped to the diff, so
# the cost tracks the change rather than the tree.
if [ -x ./scripts/mutants-staged.sh ]; then
    ./scripts/mutants-staged.sh
fi

echo "Pre-commit checks passed"
exit 0
